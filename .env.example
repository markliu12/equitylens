# ===== 运行模式 =====
# offline: 只用本地 fixture 数据 + 确定性离线模型，零外网、零费用（CI 与演示默认）
# dev:     真实数据 + 真实大模型
# demo:    真实模型 + 当前示例数据；开启邀请码与预算硬约束
APP_MODE=offline

# ===== 大模型（OpenAI 兼容协议；DeepSeek / 通义 / 智谱 均可）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 降级链：主模型失败时按顺序尝试
LLM_FALLBACK_MODELS=qwen-plus,glm-4-flash
LLM_TIMEOUT_S=90
LLM_MAX_CONCURRENCY=4

# ===== 预算硬约束（单位：人民币元 / token）=====
BUDGET_MAX_COST_CNY=1.2
BUDGET_MAX_TOKENS=180000
BUDGET_MAX_LLM_CALLS=60
DAILY_BUDGET_CNY=10

# ===== 存储 =====
DB_PATH=data/equitylens.db
CACHE_DIR=data/cache
ARTIFACT_DIR=data/artifacts

# ===== 数据源 =====
# fixture: 本地示例数据集（离线、零外网）
# akshare: 真实 A 股数据（需 pip install akshare，建议 Python 3.12）
DATA_PROVIDER=fixture
DATA_RATE_LIMIT_QPS=1

# ===== 演示模式 =====
DEMO_LIVE_ENABLED=false
# 开启公开 Demo 前请设置为高随机性邀请码；多个邀请码以英文逗号分隔
DEMO_INVITE_CODES=
